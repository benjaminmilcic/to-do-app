{
  "name": "todo-app-frontend",
  "version": "0.0.1",
  "author": "Benjamin Milčić",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build:dev": "ng build --configuration development",
    "icons": "node scripts/generate-icons.mjs",
    "icons:android": "npx @capacitor/assets generate --android --iconBackgroundColor \"#6366f1\" --iconBackgroundColorDark \"#6366f1\" --splashBackgroundColor \"#f3f2fb\" --splashBackgroundColorDark \"#0f0e17\"",
    "android:sync": "ng build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "node scripts/build-apk.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@capacitor/cli": "8.5.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~4.0.18"
  },
  "description": "Ionic/Angular PWA and Android app of the ToDo app"
}
