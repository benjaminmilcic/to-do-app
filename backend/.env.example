# Local development settings. Copy to .env and fill in.
# Production uses deploy/todo-app.env.example instead.

NODE_ENV=development
HOST=127.0.0.1
PORT=3100

# The web dev server (ionic serve / ng serve) proxies /api to this backend.
FRONTEND_URL=http://localhost:8100
APP_SCHEME=dev.benjaminmilcic.todo
APK_URL=

# Database: by default the server database through an SSH tunnel
# (npm run db:tunnel). Point DB_HOST/DB_PORT at a local MySQL instead if
# you prefer.
SSH_TUNNEL_HOST=user@your-server
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=todo_app
DB_PASS=
DB_NAME=todo_app

# At least 32 characters. Any random value is fine locally.
JWT_SECRET=

# Optional Google login. Add http://localhost:8100/api/auth/google/callback
# as authorized redirect URI in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8100/api/auth/google/callback
