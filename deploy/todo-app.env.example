# Environment for the ToDo app backend.
#
# Production: /etc/todo-app/todo-app.env (root:root, 600), read by systemd.
# Local development: copy to backend/.env and adjust.
# Never commit the real file.

NODE_ENV=production
HOST=127.0.0.1
PORT=3100

# Public URL of the web app (used for the Google login redirect).
FRONTEND_URL=https://todo-app.benjamin-milcic.dev
# Extra origins allowed to call the API. The Android app runs in a WebView
# with origin https://localhost; the web app itself is same-origin.
CORS_ORIGINS=https://localhost,capacitor://localhost
# Custom URL scheme of the native app (must match capacitor.config.ts).
APP_SCHEME=dev.benjaminmilcic.todo
# Shown as download link in the web app. Leave empty to hide it.
APK_URL=https://todo-app.benjamin-milcic.dev/downloads/todo-app.apk

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=todo_app
DB_PASS=change-me
DB_NAME=todo_app

# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90

# Optional: Google login. Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://todo-app.benjamin-milcic.dev/api/auth/google/callback

# Optional: voice input (speech-to-text with Whisper on Groq,
# https://console.groq.com/keys). Leave empty to hide the microphone button.
GROQ_API_KEY=
# whisper-large-v3 is more accurate (e.g. for Croatian), whisper-large-v3-turbo faster.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Optional: comma-separated emails that see the admin statistics in the account
# menu (number of registered users). Only Google-linked accounts qualify.
ADMIN_EMAILS=
